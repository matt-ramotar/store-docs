32:["$","div",null,{"role":"region","aria-label":"Scrollable table","tabIndex":0,"className":"my-6 max-w-full overflow-x-auto rounded-2xl border border-border bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Read","className":"border-b border-border px-4 py-3 text-left align-top font-semibold text-foreground"}],["$","th",null,{"children":"Fetches?","className":"border-b border-border px-4 py-3 text-left align-top font-semibold text-foreground"}]],"className":"align-top"}],"className":"bg-surface-secondary text-foreground"}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["Absent key, under any policy except ",["$","code",null,{"children":"LocalOnly","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]],"className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}],["$","td",null,{"children":"Yes","className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}]],"className":"align-top"}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"MustBeFresh","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}],", even against a fresh resident value"],"className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}],["$","td",null,{"children":"Always","className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}]],"className":"align-top"}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"MaxAge","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," with the resident value over its bound, invalidated, or metadata-less"],"className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}],["$","td",null,{"children":"Yes","className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}]],"className":"align-top"}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"StaleIfError","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," after invalidation, or with a metadata-less local value"],"className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}],["$","td",null,{"children":"Yes. The stale value is served only if the fetch fails.","className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}]],"className":"align-top"}],["$","tr",null,{"children":[["$","td",null,{"children":["Stale resident value under ",["$","code",null,{"children":"CachedOrFetch","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]],"className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}],["$","td",null,{"children":"Yes, in the background, after serving the stale value","className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}]],"className":"align-top"}],["$","tr",null,{"children":[["$","td",null,{"children":["Fresh resident value under ",["$","code",null,{"children":"CachedOrFetch","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]],"className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}],["$","td",null,{"children":"No","className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}]],"className":"align-top"}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"MaxAge","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," with the resident value within its bound"],"className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}],["$","td",null,{"children":"No","className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}]],"className":"align-top"}],["$","tr",null,{"children":[["$","td",null,{"children":[["$","code",null,{"children":"StaleIfError","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," with a local value whose metadata is current"],"className":"px-4 py-3 align-top leading-6 text-foreground-secondary"}],"$L5c"],"className":"align-top"}],"$L5d"],"className":"divide-y divide-separator"}]],"className":"w-full min-w-[40rem] border-collapse text-left text-sm"}]}]
33:["$","p",null,{"children":["The default behaviors in this table are each pinned by a named conformance test on\n",["$","a",null,{"href":"/docs/store6/important-defaults","children":"Important defaults","className":"font-medium text-accent-strong underline decoration-separator decoration-1 underline-offset-4 transition-colors hover:decoration-accent-strong focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"}],". That page is the specification of record\nfor defaults, and the remaining rows restate the documented ",["$","code",null,{"children":"Freshness","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," contract. If this table\nand those tests ever disagree, the tests are right."],"className":"my-4 leading-7 text-foreground"}]
34:["$","$L56",null,{"id":"stale-while-revalidate-is-the-default-shape","children":"Stale-while-revalidate is the default shape"}]
35:["$","p",null,{"children":["Under ",["$","code",null,{"children":"CachedOrFetch","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}],", a stale resident value is served immediately and one refresh runs. That\nrefresh produces ",["$","strong",null,{"children":"exactly one"}]," terminal outcome (one fresh ",["$","code",null,{"children":"Data","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}],", or one served-stale\n",["$","code",null,{"children":"Error","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}],", or one ",["$","code",null,{"children":"Revalidated","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}],"), never two."],"className":"my-4 leading-7 text-foreground"}]
36:["$","p",null,{"children":["This shape degrades gracefully offline: a user with a stale cache and no network sees data, then\none error frame, rather than a spinner. It is also why ",["$","code",null,{"children":"invalidate","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," is the safe primitive for\npull-to-refresh. The resident value keeps rendering while the refetch runs. The full comparison\nis on ",["$","a",null,{"href":"/docs/store6/invalidate-vs-clear","children":"Invalidate or clear","className":"font-medium text-accent-strong underline decoration-separator decoration-1 underline-offset-4 transition-colors hover:decoration-accent-strong focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"}],"."],"className":"my-4 leading-7 text-foreground"}]
37:["$","p",null,{"children":["What the refresh does ",["$","em",null,{"children":"not"}]," do is retry. Zero retries, zero backoff: one demand cycle invokes\nthe fetcher exactly once, a failure schedules nothing in the background, and a later call is new\ndemand rather than a continuation of the failed one. If you want retries, they belong in your\nfetcher, where you control the policy. How failures surface is covered on the\n",["$","a",null,{"href":"/docs/store6/concepts/errors","children":"errors","className":"font-medium text-accent-strong underline decoration-separator decoration-1 underline-offset-4 transition-colors hover:decoration-accent-strong focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"}]," page. Writing fetchers gets its own guide."],"className":"my-4 leading-7 text-foreground"}]
38:["$","$L56",null,{"id":"one-fetch-many-policies","children":"One fetch, many policies"}]
39:["$","p",null,{"children":["N concurrent readers of one key share one fetch. Fifty getters and fifty collectors demanding\nthe same key produce exactly one fetch, and all one hundred observe its outcome. A stream that\narrives while a fetch is in flight piggybacks on it rather than starting a second one, and this\nholds even when the callers passed different ",["$","code",null,{"children":"Freshness","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," policies. Cancelling one waiter does\nnot cancel the shared fetch. The work commits, and the next caller reuses it."],"className":"my-4 leading-7 text-foreground"}]
3a:["$","$L56",null,{"id":"typed-metadata-storemeta","children":"Typed metadata: StoreMeta"}]
3b:["$","p",null,{"children":"The freshness and identity metadata behind all of this is typed. An untyped metadata channel\ndoes not exist anywhere in Store.","className":"my-4 leading-7 text-foreground"}]
3c:["$","$5e",null,{"className":"shiki shiki-themes store-code","style":{"backgroundColor":"var(--color-store-code-surface)","color":"var(--color-store-code-foreground)"},"tabIndex":"0","data-raw-code":"public interface StoreMeta {\n    /** The wall-clock time at which the value was written, in Unix epoch milliseconds. */\n    public val writtenAtEpochMillis: Long\n\n    /** The optional entity tag associated with the value. */\n    public val etag: String?\n}","data-language":"kotlin","children":["$","code",null,{"children":[["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"color":"var(--color-store-code-keyword)"},"children":"public"}],["$","span",null,{"style":{"color":"var(--color-store-code-keyword)"},"children":" interface"}],["$","span",null,{"style":{"color":"var(--color-store-code-foreground)"},"children":" StoreMeta {"}]]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"color":"var(--color-store-code-comment)"},"children":"    /** The wall-clock time at which the value was written, in Unix epoch milliseconds. */"}]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"color":"var(--color-store-code-keyword)"},"children":"    public"}],["$","span",null,{"style":{"color":"var(--color-store-code-keyword)"},"children":" val"}],["$","span",null,{"style":{"color":"var(--color-store-code-foreground)"},"children":" writtenAtEpochMillis: Long"}]]}],"\n",["$","span",null,{"className":"line"}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"color":"var(--color-store-code-comment)"},"children":"    /** The optional entity tag associated with the value. */"}]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"color":"var(--color-store-code-keyword)"},"children":"    public"}],["$","span",null,{"style":{"color":"var(--color-store-code-keyword)"},"children":" val"}],["$","span",null,{"style":{"color":"var(--color-store-code-foreground)"},"children":" etag: String?"}]]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"color":"var(--color-store-code-foreground)"},"children":"}"}]}]],"className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]}]
3d:["$","p",null,{"children":[["$","code",null,{"children":"StoreResult.Data.age","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," and the age-bounded policies derive from this metadata. Milliseconds\nsince the Unix epoch are used because no stable cross-platform instant type exists on the\ncurrent language floor."],"className":"my-4 leading-7 text-foreground"}]
3e:["$","p",null,{"children":["The rule that ties the policies together is ",["$","strong",null,{"children":"conservative staleness"}],": a resident value with\nnull metadata is treated as conservatively stale by read planning. That single rule is why\n",["$","code",null,{"children":"CachedOrFetch","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," serves a metadata-less row and revalidates it in the background, while ",["$","code",null,{"children":"MaxAge","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}],"\nand ",["$","code",null,{"children":"MustBeFresh","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," (whose contracts require ",["$","em",null,{"children":"known"}]," freshness) withhold it and fetch."],"className":"my-4 leading-7 text-foreground"}]
3f:["$","$L56",null,{"id":"advanced-the-read-planning-seam","children":"Advanced: the read-planning seam"}]
40:["$","$L5f",null,{"children":["$","p",null,{"children":[["$","strong",null,{"children":"Experimental."}]," Everything in this section is ",["$","code",null,{"children":"@ExperimentalStoreApi","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," and lives in the\n",["$","code",null,{"children":"seam","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," package, which is a freeze candidate, not frozen. Implementing a seam interface is an\nexplicit opt-in, and shapes can change in any release. See\n",["$","a",null,{"href":"/docs/store6/stability","children":"the stability policy","className":"font-medium text-accent-strong underline decoration-separator decoration-1 underline-offset-4 transition-colors hover:decoration-accent-strong focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"}]," for what candidate-versus-frozen means."],"className":"my-4 leading-7 text-foreground"}],"type":"Warning"}]
41:["$","p",null,{"children":"You will probably never touch this seam. The five policies absorb the cases that needed custom\nvalidation logic in earlier Store versions. It exists for the rare read-planning decision the\npolicies cannot express.","className":"my-4 leading-7 text-foreground"}]
42:["$","p",null,{"children":["A ",["$","code",null,{"children":"FreshnessValidator","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," selects a fetch plan as a pure function of one coherent\n",["$","code",null,{"children":"FreshnessContext","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}],": resident availability, the resident value's recorded ",["$","code",null,{"children":"StoreMeta","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," (or null),\nepoch staleness, the read's ",["$","code",null,{"children":"Freshness","className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]," policy, the wall-clock reading captured for the plan,\nand the durable bookkeeping posture:"],"className":"my-4 leading-7 text-foreground"}]
43:["$","$60",null,{"className":"shiki shiki-themes store-code","style":{"backgroundColor":"var(--color-store-code-surface)","color":"var(--color-store-code-foreground)"},"tabIndex":"0","data-raw-code":"@ExperimentalStoreApi\n@SubclassOptInRequired(DelicateStoreApi::class)\npublic interface FreshnessValidator {\n    /** Plans whether and how the current read should fetch as a pure function of [context]. */\n    public fun plan(context: FreshnessContext): FetchPlan\n}","data-language":"kotlin","children":["$","code",null,{"children":[["$","span",null,{"className":"line","children":["$","span",null,{"style":{"color":"var(--color-store-code-foreground)"},"children":"@ExperimentalStoreApi"}]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"color":"var(--color-store-code-foreground)"},"children":"@SubclassOptInRequired(DelicateStoreApi::"}],["$","span",null,{"style":{"color":"var(--color-store-code-function)"},"children":"class"}],["$","span",null,{"style":{"color":"var(--color-store-code-foreground)"},"children":")"}]]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"color":"var(--color-store-code-keyword)"},"children":"public"}],["$","span",null,{"style":{"color":"var(--color-store-code-keyword)"},"children":" interface"}],["$","span",null,{"style":{"color":"var(--color-store-code-foreground)"},"children":" FreshnessValidator {"}]]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"color":"var(--color-store-code-comment)"},"children":"    /** Plans whether and how the current read should fetch as a pure function of [context]. */"}]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"color":"var(--color-store-code-keyword)"},"children":"    public"}],["$","span",null,{"style":{"color":"var(--color-store-code-keyword)"},"children":" fun"}],["$","span",null,{"style":{"color":"var(--color-store-code-function)"},"children":" plan"}],["$","span",null,{"style":{"color":"var(--color-store-code-foreground)"},"children":"(context: FreshnessContext): FetchPlan"}]]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"color":"var(--color-store-code-foreground)"},"children":"}"}]}]],"className":"rounded-md bg-surface-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"}]}]
